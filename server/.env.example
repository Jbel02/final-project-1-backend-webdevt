# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.

# MongoDB Atlas connection string. Leave empty in development to run on a
# throwaway in-memory database that is seeded on every start.
MONGODB_URI=

# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Local API port (the Vite dev server proxies /api here). Render sets PORT
# itself in production.
API_PORT=5000
NODE_ENV=development

# Optional: the manager password used when seeding a deployed database, so
# the demo password in the README isn't the real manager login.
SEED_MANAGER_PASSWORD=
